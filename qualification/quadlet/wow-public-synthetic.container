# SYNTHETIC ONLY: intentionally nonexistent digest; never deploy or pull.
# No policy, private source, secrets, or host-specific data are included.
[Unit]
Description=WOW public-safe synthetic rootless Podman Quadlet generator fixture

[Container]
Image=ghcr.io/sempersupra/wow-sidecar@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
Pull=never
